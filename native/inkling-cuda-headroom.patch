+#if defined(_WIN32)
+// WDDM's CUDA budget omits graphics allocations; NVML supplies whole-device availability.
+class NvmlMemoryView final {
+    struct Memory { unsigned long long total = 0, free = 0, used = 0; };
+    using Init = int (*)();
+    using ByPci = int (*)(const char*, void**);
+    using Read = int (*)(void*, Memory*);
+    HMODULE module_ = nullptr;
+    Init shutdown_ = nullptr;
+    ByPci by_pci_ = nullptr;
+    Read read_ = nullptr;
+    bool ready_ = false;
+public:
+    NvmlMemoryView() {
+        module_ = LoadLibraryExW(L"nvml.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+        if (!module_) return;
+        Init initialize = reinterpret_cast<Init>(GetProcAddress(module_, "nvmlInit_v2"));
+        shutdown_ = reinterpret_cast<Init>(GetProcAddress(module_, "nvmlShutdown"));
+        by_pci_ = reinterpret_cast<ByPci>(GetProcAddress(module_, "nvmlDeviceGetHandleByPciBusId_v2"));
+        read_ = reinterpret_cast<Read>(GetProcAddress(module_, "nvmlDeviceGetMemoryInfo"));
+        ready_ = initialize && shutdown_ && by_pci_ && read_ && initialize() == 0;
+    }
+    ~NvmlMemoryView() {
+        if (ready_) shutdown_();
+        if (module_) FreeLibrary(module_);
+    }
+    size_t FreeBytes(int gpu, size_t fallback) const {
+        if (!ready_) return fallback;
+        char pci[32] = {};
+        void* device = nullptr;
+        Memory memory;
+        if (cudaDeviceGetPCIBusId(pci, sizeof(pci), gpu) != cudaSuccess || by_pci_(pci, &device) != 0 || read_(device, &memory) != 0) return fallback;
+        return std::min(fallback, static_cast<size_t>(memory.free));
+    }
+};
+#endif
